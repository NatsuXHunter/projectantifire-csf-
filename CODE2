// --- Configuration des broches pour la carte UCA ---
const int pinCapteurNum = 2;  // Broche numérique (DO du KY-026) connectée à D2
const int pinCapteurAna = A0; // Broche analogique (AO du KY-026) connectée à A0

// --- Configuration des variables de temps (Non bloquant) ---
unsigned long tempsPrecedentFlamme = 0; 
const unsigned long intervalleFlamme = 300; 

unsigned long tempsPrecedentAucune = 0; 
const unsigned long intervalleAucune = 5000; 

// --- Paramètre du capteur ---
const int ETAT_FLAMME_ACTIVE = LOW; 

void setup() {
  Serial.begin(9600);
  
  // Configuration de la broche numérique en entrée
  pinMode(pinCapteurNum, INPUT);
  
  // Les broches analogiques n'ont généralement pas besoin de pinMode, 
  // mais on peut l'expliciter.
  pinMode(pinCapteurAna, INPUT);
  
  Serial.println("Initialisation du capteur terminée.");
}

void loop() {
  // Lecture de l'état logique et de la valeur analogique
  int etatCapteur = digitalRead(pinCapteurNum);
  int valeurCapteur = analogRead(pinCapteurAna);
  
  unsigned long tempsActuel = millis();

  // 1. Condition : Si une flamme est détectée
  if (etatCapteur == ETAT_FLAMME_ACTIVE) {
    
    if (tempsActuel - tempsPrecedentFlamme >= intervalleFlamme) {
      Serial.print("Flamme détectée ! Intensité mesurée : ");
      Serial.println(valeurCapteur); // Affiche une valeur entre 0 et 1023
      tempsPrecedentFlamme = tempsActuel;
    }
    
    // Maintien du chronomètre d'absence à zéro
    tempsPrecedentAucune = tempsActuel; 
  } 
  // 2. Condition : Si aucune flamme n'est détectée
  else {
    
    if (tempsActuel - tempsPrecedentAucune >= intervalleAucune) {
      Serial.print("Aucune flamme détectée. Niveau ambiant : ");
      Serial.println(valeurCapteur);
      tempsPrecedentAucune = tempsActuel;
    }
  }
}
