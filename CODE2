// --- Configuration des broches ---
const int pinCapteurNum = 4;   // Connectée au DO (Digital Out) du KY-026
const int pinCapteurAna = 34;  // Connectée au AO (Analog Out) du KY-026 (Broche sûre en lecture seule)

// --- Configuration des variables de temps (Non bloquant) ---
unsigned long tempsPrecedentFlamme = 0; 
const unsigned long intervalleFlamme = 300; // 300 ms

unsigned long tempsPrecedentAucune = 0; 
const unsigned long intervalleAucune = 5000; // 5 secondes

// --- Paramètre du capteur ---
const int ETAT_FLAMME_ACTIVE = LOW; 

void setup() {
  Serial.begin(9600);
  
  pinMode(pinCapteurNum, INPUT);
  // Sur ESP32, la configuration pinMode pour analogRead n'est pas strictement nécessaire, 
  // mais c'est une bonne pratique de s'assurer que la broche lit bien les données.
  
  Serial.println("Initialisation du capteur KY-026 terminée.");
}

void loop() {
  // Lecture de l'état numérique (flamme oui/non)
  int etatCapteur = digitalRead(pinCapteurNum);
  
  // Lecture de la valeur analogique (intensité de la flamme / rayonnement IR)
  // Sur un ESP32, cette valeur va de 0 à 4095.
  int intensiteIR = analogRead(pinCapteurAna);
  
  // Récupération du temps actuel
  unsigned long tempsActuel = millis();

  // 1. Condition : Si une flamme est détectée
  if (etatCapteur == ETAT_FLAMME_ACTIVE) {
    
    if (tempsActuel - tempsPrecedentFlamme >= intervalleFlamme) {
      Serial.print(" Flamme détectée ! Intensité thermique (IR) : ");
      Serial.println(intensiteIR);
      
      tempsPrecedentFlamme = tempsActuel;
    }
    
    tempsPrecedentAucune = tempsActuel; 
  } 
  // 2. Condition : Si aucune flamme n'est détectée
  else {
    
    if (tempsActuel - tempsPrecedentAucune >= intervalleAucune) {
      Serial.print(" Aucune flamme détectée. Niveau infrarouge ambiant : ");
      Serial.println(intensiteIR);
      
      tempsPrecedentAucune = tempsActuel;
    }
  }
}
