#include <SPI.h>
#include <LoRa.h>
#include <Servo.h>

Servo myservo;

// Broches LoRa pour la carte UCA21
const int csPin = 10;
const int resetPin = 8;
const int irqPin = 6;

// Variables pour la simulation des 30 secondes
unsigned long dernierTempsDetection = 0;
const unsigned long intervalleDetection = 30000; // 30 000 millisecondes = 30 secondes

void setup() {
  Serial.begin(115200);
  while (!Serial);

  myservo.attach(A2);

  // Initialisation LoRa
  LoRa.setPins(csPin, resetPin, irqPin);
  if (!LoRa.begin(868E6)) {
    Serial.println("Échec LoRa sur l'émetteur !");
    while (1);
  }
  Serial.println("Émetteur prêt. Balayage en cours...");
}

void loop() {
  // Balayage aller
  for (int i = 0; i <= 180; i = i + 5) {
    myservo.write(i);
    delay(100);
    verifierDetection(i); // On vérifie à chaque petit pas
  }
  
  // Balayage retour
  for (int i = 180; i >= 0; i = i - 5) {
    myservo.write(i);
    delay(100);
    verifierDetection(i); // On vérifie à chaque petit pas
  }
}

// Fonction qui gère la détection et l'envoi
void verifierDetection(int angleActuel) {
  // Pour utiliser le vrai capteur KY-026 plus tard, tu remplaceras la ligne ci-dessous par :
  // if (digitalRead(brocheCapteur) == HIGH) {
  if (millis() - dernierTempsDetection >= intervalleDetection) {
    
    Serial.print("Détection simulée ! Angle figé à : ");
    Serial.println(angleActuel);

    // 1. Envoyer l'angle à la deuxième carte via LoRa
    LoRa.beginPacket();
    LoRa.print(angleActuel);
    LoRa.endPacket();

    // 2. Arrêter le servomoteur pendant 1 seconde
    delay(1000);

    // 3. Réinitialiser le chronomètre pour la prochaine simulation
    dernierTempsDetection = millis();
  }
}
