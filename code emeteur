#include <SPI.h>
#include <LoRa.h>
#include <Servo.h>

Servo myservo;

// Broches matérielles LoRa de la carte UCA21
const int csPin = 10;
const int resetPin = 8;
const int irqPin = 6;

// Broches du capteur de flamme KY-026
const int pinDigital = 3; 
const int pinAnalog = A3; 

unsigned long dernierTempsMouvement = 0;
const unsigned long intervalleMouvement = 100; // Cadence du mouvement et de l'envoi
int angle = 0;
int direction = 5; 

void setup() {
  Serial.begin(115200);
  while (!Serial);

  myservo.attach(A2);
  pinMode(pinDigital, INPUT);

  LoRa.setPins(csPin, resetPin, irqPin);
  if (!LoRa.begin(868E6)) {
    Serial.println("Échec de l'initialisation LoRa !");
    while (1);
  }
  Serial.println("Émetteur actif. Affichage des données capteur :");
}

void loop() {
  // Lecture continue des valeurs du capteur
  int valDigital = digitalRead(pinDigital);
  int valAnalog = analogRead(pinAnalog);

  // Affichage PERMANENT dans le moniteur série de l'émetteur
  Serial.print("Analogique: "); Serial.print(valAnalog);
  Serial.print(" | Numérique: "); Serial.print(valDigital);
  Serial.print(" | Angle Servo: "); Serial.println(angle);

  // Gestion du déplacement du servo et envoi des données par LoRa
  if (millis() - dernierTempsMouvement >= intervalleMouvement) {
    myservo.write(angle);
    
    // Construction et envoi du paquet (Format : "angle,valDigital")
    LoRa.beginPacket();
    LoRa.print(angle);
    LoRa.print(",");
    LoRa.print(valDigital);
    LoRa.endPacket();

    // Calcul de la prochaine position
    angle += direction;
    if (angle >= 180 || angle <= 0) {
      direction = -direction; 
    }
    dernierTempsMouvement = millis();
  }
}
