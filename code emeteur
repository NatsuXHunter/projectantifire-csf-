#include <SPI.h>
#include <LoRa.h>
#include <Servo.h>

Servo myservo;

// Broches LoRa pour UCA21
const int csPin = 10;
const int resetPin = 8;
const int irqPin = 6;

// Broche du capteur de flamme
const int pinCapteur = 3; 

// Chronomètre pour le rafraîchissement toutes les 30 secondes
unsigned long dernierRefresh = 0;
const unsigned long intervalleRefresh = 30000;

// Variables pour le mouvement du servo (sans delay)
unsigned long dernierTempsMouvement = 0;
const unsigned long intervalleMouvement = 100; 
int angle = 0;
int direction = 5; 

// Variables pour la pause de 1 seconde suite à une détection
unsigned long debutPause = 0;
bool enPause = false;

void setup() {
  Serial.begin(115200);
  while (!Serial);

  myservo.attach(A2);
  pinMode(pinCapteur, INPUT); // Configuration de la broche du capteur

  // Initialisation LoRa
  LoRa.setPins(csPin, resetPin, irqPin);
  if (!LoRa.begin(868E6)) {
    Serial.println("Échec LoRa sur l'émetteur !");
    while (1);
  }
  Serial.println("Système réel prêt. Surveillance active...");
  dernierRefresh = millis(); // Initialisation du chrono
}

void loop() {
  // 1. GESTION DE LA PAUSE DE 1 SECONDE APRÈS DÉTECTION
  if (enPause) {
    if (millis() - debutPause >= 1000) {
      enPause = false; 
      dernierRefresh = millis(); // On décale le refresh pour éviter qu'il pop direct après la pause
    }
    return; // On bloque le reste de la boucle pendant la pause
  }

  // 2. SURVEILLANCE RÉELLE DU CAPTEUR (Tourne en continu sans blocage)
  // Si le capteur détecte une flamme, sa sortie DO passe à LOW
  if (digitalRead(pinCapteur) == LOW) {
    Serial.print("FLAMME DÉTECTÉE ! Angle envoyé : ");
    Serial.println(angle);

    // Envoi immédiat de l'angle par LoRa
    LoRa.beginPacket();
    LoRa.print(angle); 
    LoRa.endPacket();

    // Déclenchement de la pause d'une seconde
    enPause = true;
    debutPause = millis();
    return;
  }

  // 3. ENVOI DU REFRESH TOUTES LES 30 SECONDES (Si pas de flamme)
  if (millis() - dernierRefresh >= intervalleRefresh) {
    Serial.println("Envoi refresh : RAS ça marche");
    
    LoRa.beginPacket();
    LoRa.print("RAS ça marche"); // Envoi du texte de statut
    LoRa.endPacket();

    dernierRefresh = millis();
  }

  // 4. BALAYAGE DU SERVOMOTEUR
  if (millis() - dernierTempsMouvement >= intervalleMouvement) {
    myservo.write(angle);
    angle += direction;
    if (angle >= 180 || angle <= 0) {
      direction = -direction; 
    }
    dernierTempsMouvement = millis();
  }
}
