#include <SPI.h>
#include <LoRa.h>
#include <Servo.h>

Servo myservo;

const int csPin = 10;
const int resetPin = 8;
const int irqPin = 6;

const int pinDigital = 3; 
const int pinAnalog = A3; 

// Chrono du moteur (Balayage continu)
unsigned long dernierTempsMouvement = 0;
const unsigned long intervalleMouvement = 100; 

// Chrono de l'Alerte Feu (Cooldown de 3 secondes anti-spam)
unsigned long dernierTempsFeu = 0;
const unsigned long intervalleAlerteFeu = 3000; 

// Chrono du RAS (Toutes les 20 secondes)
unsigned long dernierTempsLoRaRefresh = 0;
const unsigned long intervalleLoRaRefresh = 20000; 

int angle = 0;
int direction = 5; 

void setup() {
  Serial.begin(115200);
  while (!Serial);

  myservo.attach(A2);
  pinMode(pinDigital, INPUT);

  LoRa.setPins(csPin, resetPin, irqPin);
  if (!LoRa.begin(868E6)) {
    Serial.println("Échec LoRa !");
    while (1);
  }
  Serial.println("Émetteur prêt. Algorithme anti-spam activé.");
}

void loop() {
  // LECTURE DU CAPTEUR (Pour ton test, commente la ligne ci-dessous et mets valDigital à 0)
  int valDigital = digitalRead(pinDigital); 
  // int valDigital = 0; 
  int valAnalog = analogRead(pinAnalog);

  // 1. MOUVEMENT ET AFFICHAGE LOCAL (Tourne en permanence sans aucun délai)
  if (millis() - dernierTempsMouvement >= intervalleMouvement) {
    myservo.write(angle);
    
    Serial.print("Analogique: "); Serial.print(valAnalog);
    Serial.print(" | Numérique: "); Serial.print(valDigital);
    Serial.print(" | Angle: "); Serial.println(angle);

    angle += direction;
    if (angle >= 180 || angle <= 0) {
      direction = -direction; 
    }
    dernierTempsMouvement = millis();
  }

  // 2. GESTION DU FEU (Envoi LoRa avec Cooldown de 3 secondes)
  if (valDigital == LOW) {
    if (millis() - dernierTempsFeu >= intervalleAlerteFeu) {
      LoRa.beginPacket();
      LoRa.print("FEU,");
      LoRa.print(angle);
      LoRa.endPacket();
      
      dernierTempsFeu = millis();
      // On remet le chrono du RAS à zéro pour éviter d'envoyer un RAS en plein incendie
      dernierTempsLoRaRefresh = millis(); 
    }
  }

  // 3. GESTION DU RAS (Envoi LoRa toutes les 20 secondes si tout va bien)
  if (valDigital == HIGH) {
    if (millis() - dernierTempsLoRaRefresh >= intervalleLoRaRefresh) {
      LoRa.beginPacket();
      LoRa.print("RAS,");
      LoRa.print(angle);
      LoRa.endPacket();
      
      dernierTempsLoRaRefresh = millis();
    }
  }
}
