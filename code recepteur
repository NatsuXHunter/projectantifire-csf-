#include <SPI.h>
#include <LoRa.h>
#include <Servo.h>

Servo servoRecepteur;

const int csPin = 10;
const int resetPin = 8;
const int irqPin = 6;

void setup() {
  Serial.begin(115200);
  while (!Serial);

  servoRecepteur.attach(A2);

  LoRa.setPins(csPin, resetPin, irqPin);
  if (!LoRa.begin(868E6)) {
    Serial.println("Échec LoRa !");
    while (1);
  }
  Serial.println("Récepteur prêt. (N'oublie pas d'activer l'horodatage sur le moniteur série !)");
}

void loop() {
  int packetSize = LoRa.parsePacket();
  
  if (packetSize) {
    String messageRecu = "";
    while (LoRa.available()) {
      messageRecu += (char)LoRa.read();
    }

    // On cherche la virgule pour séparer le mot (RAS/FEU) de l'angle
    int indexVirgule = messageRecu.indexOf(',');
    if (indexVirgule != -1) {
      String statut = messageRecu.substring(0, indexVirgule);
      String angleStr = messageRecu.substring(indexVirgule + 1);
      int angleCible = angleStr.toInt();

      // Mise à jour de la position du moteur 
      if (angleCible >= 0 && angleCible <= 180) {
        servoRecepteur.write(angleCible);
      }

      // Affichage du statut
      if (statut == "FEU") {
        Serial.print("Moteurs synchronisés à l'angle : ");
        Serial.print(angleCible);
        Serial.println("° - ALERTE : Feu Détecté !");
      } 
      else if (statut == "RAS") {
        Serial.print("Moteurs synchronisés à l'angle : ");
        Serial.print(angleCible);
        Serial.println("° - RAS");
      }
    }
  }
}
