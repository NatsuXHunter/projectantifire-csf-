#include <SPI.h>
#include <LoRa.h>
#include <Servo.h>

Servo servoRecepteur;

const int csPin = 10;
const int resetPin = 8;
const int irqPin = 6;

void setup() {
  Serial.begin(115200);
  while (!Serial);

  servoRecepteur.attach(A2);

  LoRa.setPins(csPin, resetPin, irqPin);
  if (!LoRa.begin(868E6)) {
    Serial.println("Échec LoRa sur le récepteur !");
    while (1);
  }
  Serial.println("Récepteur prêt. À l'écoute du réseau...");
}

void loop() {
  int packetSize = LoRa.parsePacket();
  
  if (packetSize) {
    String messageRecu = "";
    while (LoRa.available()) {
      messageRecu += (char)LoRa.read();
    }

    // ANALYSE DU MESSAGE REÇU
    if (messageRecu == "RAS ça marche") {
      // C'est le message de statut des 30 secondes
      Serial.print("[Statut Émetteur] : ");
      Serial.println(messageRecu);
    } 
    else {
      // Ce n'est pas le texte de statut, c'est donc un angle (chiffre)
      int angleCible = messageRecu.toInt();
      
      // Sécurité : on vérifie que la conversion a donné un angle valide
      if (angleCible >= 0 && angleCible <= 180) {
        Serial.print("Alerte reçu ! Alignement du servo sur l'angle : ");
        Serial.println(angleCible);
        
        servoRecepteur.write(angleCible);
      }
    }
  }
}
