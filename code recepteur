#include <SPI.h>
#include <LoRa.h>
#include <Servo.h>

Servo servoRecepteur;

const int csPin = 10;
const int resetPin = 8;
const int irqPin = 6;

unsigned long dernierRefresh = 0;
const unsigned long intervalleRefresh = 20000; // 20 secondes

int angleCourant = 0;

void setup() {
  Serial.begin(115200);
  while (!Serial);

  servoRecepteur.attach(A2);

  LoRa.setPins(csPin, resetPin, irqPin);
  if (!LoRa.begin(868E6)) {
    Serial.println("Échec de l'initialisation LoRa !");
    while (1);
  }
  Serial.println("Récepteur actif. En attente de synchronisation...");
}

void loop() {
  // Vérification de la réception d'un paquet LoRa
  int packetSize = LoRa.parsePacket();
  
  if (packetSize) {
    String messageRecu = "";
    while (LoRa.available()) {
      messageRecu += (char)LoRa.read();
    }

    // Découpage du message reçu autour de la virgule
    int indexVirgule = messageRecu.indexOf(',');
    if (indexVirgule != -1) {
      String angleStr = messageRecu.substring(0, indexVirgule);
      String digitalStr = messageRecu.substring(indexVirgule + 1);

      int angleCible = angleStr.toInt();
      int etatFlamme = digitalStr.toInt();

      // Synchronisation du servomoteur local
      if (angleCible >= 0 && angleCible <= 180) {
        servoRecepteur.write(angleCible);
        angleCourant = angleCible; 
      }

      // Action immédiate si une flamme est détectée (KY-026 passe à LOW)
      if (etatFlamme == LOW) {
        afficherHorodatage();
        Serial.print(" Moteurs synchronisés à l'angle : ");
        Serial.print(angleCourant);
        Serial.println("° - Feu Détecté !");
      }
    }
  }

  // Affichage du statut global "RAS" toutes les 20 secondes
  if (millis() - dernierRefresh >= intervalleRefresh) {
    afficherHorodatage();
    Serial.print(" Moteurs synchronisés à l'angle : ");
    Serial.print(angleCourant);
    Serial.println("° - RAS");
    
    dernierRefresh = millis();
  }
}

// Fonction générant l'horodatage relatif (Uptime de la carte)
void afficherHorodatage() {
  unsigned long totalSecondes = millis() / 1000;
  unsigned long s = totalSecondes % 60;
  unsigned long m = (totalSecondes / 60) % 60;
  unsigned long h = (totalSecondes / 3600);

  Serial.print("[");
  if (h < 10) Serial.print("0");
  Serial.print(h);
  Serial.print(":");
  if (m < 10) Serial.print("0");
  Serial.print(m);
  Serial.print(":");
  if (s < 10) Serial.print("0");
  Serial.print(s);
  Serial.print("]");
}
